OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
MODEL_PROVIDER=deterministic
DATABASE_URL=sqlite+aiosqlite:///./research.db
OBJECT_STORE_PATH=.data/objects
OBJECT_STORE_BACKEND=filesystem
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=research-documents
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
ADMIN_TOKEN=
ADMIN_SESSION_SECRET=
# Use false for local HTTP. Set true for an HTTPS deployment.
ADMIN_COOKIE_SECURE=false
SEC_USER_AGENT=SignalForge research@example.com
UNIVERSE_AUTO_SYNC=true
UNIVERSE_SYNC_HOUR_UTC=18
FIXTURE_MODE=false
